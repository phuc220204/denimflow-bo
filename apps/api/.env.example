# Copy to apps/api/.env and fill with the DEV project values (DEVELOPMENT_SETUP.md §4).
# Placeholders only: never commit real values. .env is git-ignored.

NODE_ENV=development
PORT=3000

# Supabase → Connect → Transaction pooler (port 6543), used by the API at runtime
DATABASE_URL=postgresql://postgres.replace-me:replace-me@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# Supabase → Connect → Direct connection, or Session pooler (port 5432) on IPv4-only networks; used by migrations
DIRECT_URL=postgresql://postgres.replace-me:replace-me@aws-0-region.pooler.supabase.com:5432/postgres

# Supabase → Project settings → API (used from T0.4 part B)
SUPABASE_URL=https://replace-me.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Only if the project still uses the legacy shared JWT secret; leave empty to verify via JWKS
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=denimflow-files

# Comma-separated web origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# Initial password of the seeded demo users (used from T0.4 part B)
SEED_DEFAULT_PASSWORD=replace-me
