{
  "name": "@denimflow/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:test:up": "docker run -d --rm --name denimflow-test-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=denimflow_test -p 54329:5432 postgres:17-alpine",
    "db:test:down": "docker stop denimflow-test-db",
    "db:seed": "pnpm --filter \"@denimflow/api...\" build && node --env-file-if-exists=.env dist/seed/index.js",
    "postinstall": "prisma generate",
    "smoke:roles": "node --env-file-if-exists=.env scripts/role-smoke-test.mjs",
    "demo:reseed": "pnpm --filter \"@denimflow/api...\" build && node --env-file-if-exists=.env scripts/demo-reseed.mjs && pnpm db:seed",
    "demo:walkthrough": "node --env-file-if-exists=.env scripts/demo-walkthrough.mjs"
  },
  "dependencies": {
    "@denimflow/engine": "workspace:*",
    "@denimflow/shared": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/supabase-js": "^2.118.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.1",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
