// Source of truth for the design: docs/en/DATABASE_DESIGN.md. Enum values mirror
// packages/shared/src/enums.ts.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PROCESS_ENGINEER
  PRODUCTION_PLANNER
  WAREHOUSE_KEEPER
  STATION_OPERATOR
  QC_INSPECTOR
  MANAGER
}

enum VersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum StepType {
  SELECTION
  MATERIAL
  PRODUCTION
  QC
  APPROVAL
}

enum TransitionKind {
  NORMAL
  REWORK
}

enum StationType {
  CUTTING
  SEWING
  EMBROIDERY
  DYEING
  WASH
  FINISHING
  QC
  PACKING
}

enum StretchType {
  RIGID
  STRETCH
}

enum QcProfileType {
  FULL_PROCESS
  SKIP_CLEAN_WASH
}

// id equals auth.users.id in Supabase. station_id is linked to stations.
model Profile {
  id              String            @id @db.Uuid
  fullName        String            @map("full_name")
  email           String            @unique
  role            Role
  stationId       String?           @map("station_id") @db.Uuid
  station         Station?          @relation(fields: [stationId], references: [id], onDelete: SetNull)
  isActive        Boolean           @default(true) @map("is_active")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  createdVersions WorkflowVersion[]

  @@map("profiles")
}

// Stations in the manufacturing floor
model Station {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String      @unique
  name         String
  stationType  StationType @map("station_type")
  isOutsourced Boolean     @default(false) @map("is_outsourced")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  profiles     Profile[]

  @@map("stations")
}

// Master data: Styles of jeans
model Style {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  styleCode         String            @unique @map("style_code")
  name              String
  fitType           String?           @map("fit_type")
  defaultTemplateId String?           @map("default_template_id") @db.Uuid
  hasEmbroidery     Boolean           @default(false) @map("has_embroidery")
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  defaultTemplate   WorkflowTemplate? @relation(fields: [defaultTemplateId], references: [id])
  qcProfiles        QcProfile[]

  @@map("styles")
}

// Master data: Fabric types
model FabricType {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String            @unique
  name        String
  weightOz    Decimal?          @map("weight_oz") @db.Decimal(4, 1)
  composition String?
  stretchType StretchType       @map("stretch_type")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  colorRules  FabricColorRule[]

  @@map("fabric_types")
}

// Master data: Color options
model ColorOption {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String            @unique
  name        String
  colorFamily String?           @map("color_family")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  fabricRules FabricColorRule[]

  @@map("color_options")
}

// Master data: Fabric-Color compatibility rules (BR-04, FR-02)
model FabricColorRule {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fabricTypeId String      @map("fabric_type_id") @db.Uuid
  colorId      String      @map("color_id") @db.Uuid
  isAllowed    Boolean     @default(true) @map("is_allowed")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  fabricType   FabricType  @relation(fields: [fabricTypeId], references: [id], onDelete: Cascade)
  colorOption  ColorOption @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@unique([fabricTypeId, colorId])
  @@map("fabric_color_rules")
}

// Master data: QC Profiles with shrinkage and color fading thresholds (BR-19, FR-28)
model QcProfile {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  styleId             String        @map("style_id") @db.Uuid
  profileType         QcProfileType @map("profile_type")
  maxShrinkagePercent Decimal       @map("max_shrinkage_percent") @db.Decimal(5, 2)
  maxColorFadingLevel Int           @map("max_color_fading_level") @db.SmallInt
  isActive            Boolean       @default(true) @map("is_active")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  style               Style         @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@unique([styleId, profileType])
  @@map("qc_profiles")
}

// Master data: Wash types
model WashType {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("wash_types")
}

// Append-only (BR-16): a trigger in the migration blocks UPDATE, DELETE and TRUNCATE.
// Polymorphic on purpose (entity_type, entity_id), so it has no foreign keys.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  action     String
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  actorId    String?  @map("actor_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model WorkflowTemplate {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  isActive         Boolean           @default(true) @map("is_active")
  isDedicated      Boolean           @default(false) @map("is_dedicated")
  orderId          String?           @map("order_id") @db.Uuid
  currentVersionId String?           @map("current_version_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  versions         WorkflowVersion[]
  styles           Style[]

  @@map("workflow_templates")
}

model WorkflowVersion {
  id          String           @id @default(uuid()) @db.Uuid
  templateId  String           @map("template_id") @db.Uuid
  versionNo   Int              @map("version_no")
  status      VersionStatus    @default(DRAFT)
  publishedAt DateTime?        @map("published_at") @db.Timestamptz
  createdBy   String?          @map("created_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  template    WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  creator     Profile?         @relation(fields: [createdBy], references: [id])
  steps       StepDefinition[]
  transitions StepTransition[]

  @@unique([templateId, versionNo])
  @@map("workflow_versions")
}

model StepDefinition {
  id               String           @id @default(uuid()) @db.Uuid
  versionId        String           @map("version_id") @db.Uuid
  code             String
  name             String
  stepType         StepType         @map("step_type")
  seq              Int
  responsibleRole  Role             @map("responsible_role")
  stationType      StationType?     @map("station_type")
  isMandatory      Boolean          @default(true) @map("is_mandatory")
  requiresEvidence Boolean          @default(false) @map("requires_evidence")
  requiresQc       Boolean          @default(false) @map("requires_qc")
  conditionExpr    Json?            @map("condition_expr")
  maxRework        Int?             @map("max_rework") @db.SmallInt
  isStart          Boolean          @default(false) @map("is_start")
  isEnd            Boolean          @default(false) @map("is_end")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  version          WorkflowVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  fromTransitions  StepTransition[] @relation("FromStep")
  toTransitions    StepTransition[] @relation("ToStep")

  @@unique([versionId, code])
  @@map("step_definitions")
}

model StepTransition {
  id            String          @id @default(uuid()) @db.Uuid
  versionId     String          @map("version_id") @db.Uuid
  fromStepId    String          @map("from_step_id") @db.Uuid
  toStepId      String          @map("to_step_id") @db.Uuid
  conditionExpr Json?           @map("condition_expr")
  kind          TransitionKind  @default(NORMAL)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  version       WorkflowVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  fromStep      StepDefinition  @relation("FromStep", fields: [fromStepId], references: [id], onDelete: Cascade)
  toStep        StepDefinition  @relation("ToStep", fields: [toStepId], references: [id], onDelete: Cascade)

  @@unique([versionId, fromStepId, toStepId, kind])
  @@map("step_transitions")
}


