// Source of truth for the design: docs/en/DATABASE_DESIGN.md. Enum values mirror
// packages/shared/src/enums.ts.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PROCESS_ENGINEER
  PRODUCTION_PLANNER
  WAREHOUSE_KEEPER
  STATION_OPERATOR
  QC_INSPECTOR
  MANAGER
}

enum VersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum StepType {
  SELECTION
  MATERIAL
  PRODUCTION
  QC
  APPROVAL
}

enum TransitionKind {
  NORMAL
  REWORK
}

enum StationType {
  CUTTING
  SEWING
  EMBROIDERY
  DYEING
  WASH
  FINISHING
  QC
  PACKING
}

enum StretchType {
  RIGID
  STRETCH
}

enum QcProfileType {
  FULL_PROCESS
  SKIP_CLEAN_WASH
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum DyeMode {
  TOTAL
  PARTIAL
}

enum DyeSource {
  INTERNAL
  OUTSOURCED
}

enum MaterialType {
  FABRIC
  THREAD
  BUTTON
  RIVET
  ZIPPER
  LABEL
  PACKAGING
}

enum RequestStatus {
  OPEN
  ORDERED
  RECEIVED
  CANCELLED
}

enum AckType {
  SKIP_CLEAN_WASH
}

enum InstanceStatus {
  RUNNING
  COMPLETED
  CANCELLED
}

enum StepStatus {
  PENDING
  READY
  IN_PROGRESS
  WAITING_QC
  REWORK
  DONE
  SKIPPED
}

enum QcResult {
  PASS
  REWORK
  REJECT
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// id equals auth.users.id in Supabase. station_id is linked to stations.
model Profile {
  id                       String                    @id @db.Uuid
  fullName                 String                    @map("full_name")
  email                    String                    @unique
  role                     Role
  stationId                String?                   @map("station_id") @db.Uuid
  station                  Station?                  @relation(fields: [stationId], references: [id], onDelete: SetNull)
  isActive                 Boolean                   @default(true) @map("is_active")
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.Timestamptz
  createdVersions          WorkflowVersion[]
  createdOrders            ProductionOrder[]
  requestedMaterials       MaterialRequest[]
  recordedAcknowledgements CustomerAcknowledgement[]
  assignedStepInstances    StepInstance[]            @relation("AssignedStepInstances")
  performedStepInstances   StepInstance[]            @relation("PerformedStepInstances")
  completedStepInstances   StepInstance[]            @relation("CompletedStepInstances")
  quantityEntries          StepQuantityEntry[]

  @@map("profiles")
}

// Stations in the manufacturing floor
model Station {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String      @unique
  name         String
  stationType  StationType @map("station_type")
  isOutsourced Boolean     @default(false) @map("is_outsourced")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  profiles     Profile[]

  @@map("stations")
}

// Master data: Styles of jeans
model Style {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  styleCode         String            @unique @map("style_code")
  name              String
  fitType           String?           @map("fit_type")
  defaultTemplateId String?           @map("default_template_id") @db.Uuid
  hasEmbroidery     Boolean           @default(false) @map("has_embroidery")
  // BR-07: the cut may exceed the plan by this percentage (R-19)
  cutTolerancePercent Decimal         @default(5) @map("cut_tolerance_percent") @db.Decimal(5, 2)
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  defaultTemplate   WorkflowTemplate? @relation(fields: [defaultTemplateId], references: [id])
  qcProfiles        QcProfile[]
  orders            ProductionOrder[]
  bomNorms          BomNorm[]

  @@map("styles")
}

// Master data: Fabric types
model FabricType {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String            @unique
  name        String
  weightOz    Decimal?          @map("weight_oz") @db.Decimal(4, 1)
  composition String?
  stretchType StretchType       @map("stretch_type")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  colorRules  FabricColorRule[]
  orders      ProductionOrder[]
  fabricLots  FabricLot[]

  @@map("fabric_types")
}

// Master data: Color options
model ColorOption {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String            @unique
  name        String
  colorFamily String?           @map("color_family")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  fabricRules FabricColorRule[]
  orders      ProductionOrder[]
  fabricLots  FabricLot[]

  @@map("color_options")
}

// Master data: Fabric-Color compatibility rules (BR-04, FR-02)
model FabricColorRule {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fabricTypeId String      @map("fabric_type_id") @db.Uuid
  colorId      String      @map("color_id") @db.Uuid
  isAllowed    Boolean     @default(true) @map("is_allowed")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  fabricType   FabricType  @relation(fields: [fabricTypeId], references: [id], onDelete: Cascade)
  colorOption  ColorOption @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@unique([fabricTypeId, colorId])
  @@map("fabric_color_rules")
}

// Master data: QC Profiles with shrinkage and color fading thresholds (BR-19, FR-28)
model QcProfile {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  styleId                  String                    @map("style_id") @db.Uuid
  profileType              QcProfileType             @map("profile_type")
  maxShrinkagePercent      Decimal                   @map("max_shrinkage_percent") @db.Decimal(5, 2)
  maxColorFadingLevel      Int                       @map("max_color_fading_level") @db.SmallInt
  isActive                 Boolean                   @default(true) @map("is_active")
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  style                    Style                     @relation(fields: [styleId], references: [id], onDelete: Cascade)
  orders                   ProductionOrder[]
  customerAcknowledgements CustomerAcknowledgement[]

  @@unique([styleId, profileType])
  @@map("qc_profiles")
}

// Master data: Wash types
model WashType {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String            @unique
  name        String
  description String?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  orders      ProductionOrder[]

  @@map("wash_types")
}

// Append-only (BR-16): a trigger in the migration blocks UPDATE, DELETE and TRUNCATE.
// Polymorphic on purpose (entity_type, entity_id), so it has no foreign keys.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  action     String
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  actorId    String?  @map("actor_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model WorkflowTemplate {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  isActive         Boolean           @default(true) @map("is_active")
  isDedicated      Boolean           @default(false) @map("is_dedicated")
  orderId          String?           @map("order_id") @db.Uuid
  currentVersionId String?           @map("current_version_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  versions         WorkflowVersion[]
  styles           Style[]

  @@map("workflow_templates")
}

model WorkflowVersion {
  id          String             @id @default(uuid()) @db.Uuid
  templateId  String             @map("template_id") @db.Uuid
  versionNo   Int                @map("version_no")
  status      VersionStatus      @default(DRAFT)
  publishedAt DateTime?          @map("published_at") @db.Timestamptz
  createdBy   String?            @map("created_by") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  template    WorkflowTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  creator     Profile?           @relation(fields: [createdBy], references: [id])
  steps       StepDefinition[]
  transitions StepTransition[]
  instances   WorkflowInstance[]

  @@unique([templateId, versionNo])
  @@map("workflow_versions")
}

model StepDefinition {
  id               String           @id @default(uuid()) @db.Uuid
  versionId        String           @map("version_id") @db.Uuid
  code             String
  name             String
  stepType         StepType         @map("step_type")
  seq              Int
  responsibleRole  Role             @map("responsible_role")
  stationType      StationType?     @map("station_type")
  isMandatory      Boolean          @default(true) @map("is_mandatory")
  requiresEvidence Boolean          @default(false) @map("requires_evidence")
  requiresQc       Boolean          @default(false) @map("requires_qc")
  conditionExpr    Json?            @map("condition_expr")
  maxRework        Int?             @map("max_rework") @db.SmallInt
  isStart          Boolean          @default(false) @map("is_start")
  isEnd            Boolean          @default(false) @map("is_end")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  version          WorkflowVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  fromTransitions  StepTransition[] @relation("FromStep")
  toTransitions    StepTransition[] @relation("ToStep")
  stepInstances    StepInstance[]

  @@unique([versionId, code])
  @@map("step_definitions")
}

model StepTransition {
  id            String          @id @default(uuid()) @db.Uuid
  versionId     String          @map("version_id") @db.Uuid
  fromStepId    String          @map("from_step_id") @db.Uuid
  toStepId      String          @map("to_step_id") @db.Uuid
  conditionExpr Json?           @map("condition_expr")
  kind          TransitionKind  @default(NORMAL)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  version       WorkflowVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  fromStep      StepDefinition  @relation("FromStep", fields: [fromStepId], references: [id], onDelete: Cascade)
  toStep        StepDefinition  @relation("ToStep", fields: [toStepId], references: [id], onDelete: Cascade)

  @@unique([versionId, fromStepId, toStepId, kind])
  @@map("step_transitions")
}

model ProductionOrder {
  id                    String                    @id @default(uuid()) @db.Uuid
  orderNumber           String                    @unique @map("order_number")
  styleId               String                    @map("style_id") @db.Uuid
  fabricTypeId          String?                   @map("fabric_type_id") @db.Uuid
  colorId               String?                   @map("color_id") @db.Uuid
  washTypeId            String?                   @map("wash_type_id") @db.Uuid
  dyeRequired           Boolean                   @default(false) @map("dye_required")
  dyeMode               DyeMode?                  @map("dye_mode")
  dyeSource             DyeSource?                @map("dye_source")
  embroideryRequired    Boolean                   @default(false) @map("embroidery_required")
  fabricInspectRequired Boolean                   @default(false) @map("fabric_inspect_required")
  ppSampleRequired      Boolean                   @default(false) @map("pp_sample_required")
  skipCleanWash         Boolean                   @default(false) @map("skip_clean_wash")
  qcProfileId           String?                   @map("qc_profile_id") @db.Uuid
  isCustom              Boolean                   @default(false) @map("is_custom")
  status                OrderStatus               @default(DRAFT)
  dueDate               DateTime                  @map("due_date") @db.Date
  customerRef           String?                   @map("customer_ref")
  notes                 String?
  createdBy             String                    @map("created_by") @db.Uuid
  confirmedAt           DateTime?                 @map("confirmed_at") @db.Timestamptz
  version               Int                       @default(0)
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  style                 Style                     @relation(fields: [styleId], references: [id])
  fabricType            FabricType?               @relation(fields: [fabricTypeId], references: [id])
  color                 ColorOption?              @relation(fields: [colorId], references: [id])
  washType              WashType?                 @relation(fields: [washTypeId], references: [id])
  qcProfile             QcProfile?                @relation(fields: [qcProfileId], references: [id])
  creator               Profile                   @relation(fields: [createdBy], references: [id])
  sizeLines             OrderSizeLine[]
  bomLines              BomLine[]
  materialRequests      MaterialRequest[]
  customerAcknowledgements CustomerAcknowledgement[]
  workflowInstance      WorkflowInstance?
  bundles               Bundle[]

  @@index([status, dueDate])
  @@map("production_orders")
}

model OrderSizeLine {
  id         String          @id @default(uuid()) @db.Uuid
  orderId    String          @map("order_id") @db.Uuid
  size       String
  plannedQty Int             @map("planned_qty")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  order      ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, size])
  @@index([orderId])
  @@map("order_size_lines")
}

model BomNorm {
  id             String       @id @default(uuid()) @db.Uuid
  styleId        String       @map("style_id") @db.Uuid
  size           String
  materialType   MaterialType @map("material_type")
  qtyPerPiece    Decimal      @map("qty_per_piece") @db.Decimal(10, 3)
  unit           String
  wastagePercent Decimal      @default(0) @map("wastage_percent") @db.Decimal(5, 2)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  style          Style        @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@unique([styleId, size, materialType])
  @@map("bom_norms")
}

model BomLine {
  id                  String               @id @default(uuid()) @db.Uuid
  orderId             String               @map("order_id") @db.Uuid
  materialType        MaterialType         @map("material_type")
  requiredQty         Decimal              @map("required_qty") @db.Decimal(12, 3)
  unit                String
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  order               ProductionOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  materialAllocations MaterialAllocation[]
  materialRequests    MaterialRequest[]

  @@index([orderId])
  @@map("bom_lines")
}

model FabricLot {
  id               String               @id @default(uuid()) @db.Uuid
  fabricTypeId     String               @map("fabric_type_id") @db.Uuid
  colorId          String               @map("color_id") @db.Uuid
  lotNo            String               @unique @map("lot_no")
  availableMeters  Decimal              @map("available_meters") @db.Decimal(12, 2)
  shrinkagePercent Decimal?             @map("shrinkage_percent") @db.Decimal(5, 2)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  fabricType       FabricType           @relation(fields: [fabricTypeId], references: [id])
  colorOption      ColorOption          @relation(fields: [colorId], references: [id])
  materialAllocations MaterialAllocation[]

  @@map("fabric_lots")
}

model MaterialAllocation {
  id           String      @id @default(uuid()) @db.Uuid
  bomLineId    String      @map("bom_line_id") @db.Uuid
  fabricLotId  String      @map("fabric_lot_id") @db.Uuid
  allocatedQty Decimal     @map("allocated_qty") @db.Decimal(12, 3)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  bomLine      BomLine     @relation(fields: [bomLineId], references: [id], onDelete: Cascade)
  fabricLot    FabricLot   @relation(fields: [fabricLotId], references: [id])

  @@index([bomLineId])
  @@map("material_allocations")
}

model MaterialRequest {
  id          String          @id @default(uuid()) @db.Uuid
  orderId     String          @map("order_id") @db.Uuid
  bomLineId   String          @map("bom_line_id") @db.Uuid
  missingQty  Decimal         @map("missing_qty") @db.Decimal(12, 3)
  status      RequestStatus   @default(OPEN)
  requestedBy String          @map("requested_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  order       ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bomLine     BomLine         @relation(fields: [bomLineId], references: [id], onDelete: Cascade)
  requester   Profile         @relation(fields: [requestedBy], references: [id])

  @@index([orderId])
  @@map("material_requests")
}

model CustomerAcknowledgement {
  id                 String          @id @default(uuid()) @db.Uuid
  orderId            String          @map("order_id") @db.Uuid
  ackType            AckType         @map("ack_type")
  qcProfileId        String          @map("qc_profile_id") @db.Uuid
  filePath           String          @map("file_path")
  acknowledgedByName String          @map("acknowledged_by_name")
  acknowledgedAt     DateTime        @map("acknowledged_at") @db.Timestamptz
  recordedBy         String          @map("recorded_by") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  order              ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  qcProfile          QcProfile       @relation(fields: [qcProfileId], references: [id])
  recorder           Profile         @relation(fields: [recordedBy], references: [id])

  @@index([orderId])
  @@map("customer_acknowledgements")
}

model WorkflowInstance {
  id            String          @id @default(uuid()) @db.Uuid
  orderId       String          @unique @map("order_id") @db.Uuid
  versionId     String          @map("version_id") @db.Uuid
  status        InstanceStatus  @default(RUNNING)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  order         ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  version       WorkflowVersion @relation(fields: [versionId], references: [id])
  stepInstances StepInstance[]

  @@map("workflow_instances")
}

model StepInstance {
  id               String           @id @default(uuid()) @db.Uuid
  instanceId       String           @map("instance_id") @db.Uuid
  stepDefinitionId String           @map("step_definition_id") @db.Uuid
  status           StepStatus       @default(PENDING)
  assignedTo       String?          @map("assigned_to") @db.Uuid
  performedBy      String?          @map("performed_by") @db.Uuid
  // BR-11: who finished the step (R-23)
  completedBy      String?          @map("completed_by") @db.Uuid
  startedAt        DateTime?        @map("started_at") @db.Timestamptz
  completedAt      DateTime?        @map("completed_at") @db.Timestamptz
  qtyIn            Int?             @map("qty_in")
  qtyGood          Int?             @map("qty_good")
  qtyDefect        Int?             @map("qty_defect")
  reworkCount      Int              @default(0) @map("rework_count") @db.SmallInt
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  instance         WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepDefinition   StepDefinition   @relation(fields: [stepDefinitionId], references: [id])
  assignee         Profile?         @relation("AssignedStepInstances", fields: [assignedTo], references: [id])
  performer        Profile?         @relation("PerformedStepInstances", fields: [performedBy], references: [id])
  completer        Profile?         @relation("CompletedStepInstances", fields: [completedBy], references: [id], onDelete: Restrict)
  quantityEntries  StepQuantityEntry[]

  @@unique([instanceId, stepDefinitionId])
  @@index([instanceId])
  @@index([stepDefinitionId])
  @@index([status])
  @@map("step_instances")
}

// FR-15: created from the good pieces cut per size when CUTTING completes (R-20)
model Bundle {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  bundleCode String   @map("bundle_code")
  size       String
  qty        Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  order           ProductionOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  quantityEntries StepQuantityEntry[]

  @@unique([orderId, bundleCode])
  @@index([orderId])
  @@map("bundles")
}

// FR-13: append-only (R-03). A reversal row cancels one earlier row with negated values (R-22).
// CHECK constraints and the append-only trigger live in the migration SQL.
model StepQuantityEntry {
  id              String   @id @default(uuid()) @db.Uuid
  stepInstanceId  String   @map("step_instance_id") @db.Uuid
  bundleId        String?  @map("bundle_id") @db.Uuid
  size            String?
  qtyGood         Int      @map("qty_good")
  qtyDefect       Int      @map("qty_defect")
  qtySent         Int?     @map("qty_sent")
  qtyReceived     Int?     @map("qty_received")
  mismatchReason  String?  @map("mismatch_reason")
  note            String?
  reversesEntryId String?  @unique @map("reverses_entry_id") @db.Uuid
  enteredBy       String   @map("entered_by") @db.Uuid
  enteredAt       DateTime @default(now()) @map("entered_at") @db.Timestamptz

  stepInstance     StepInstance       @relation(fields: [stepInstanceId], references: [id], onDelete: Restrict)
  bundle           Bundle?            @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  enteredByProfile Profile            @relation(fields: [enteredBy], references: [id], onDelete: Restrict)
  reverses         StepQuantityEntry? @relation("QuantityReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy       StepQuantityEntry? @relation("QuantityReversal")

  @@index([stepInstanceId])
  @@index([bundleId])
  @@map("step_quantity_entries")
}


