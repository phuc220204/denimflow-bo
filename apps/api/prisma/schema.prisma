// Source of truth for the design: docs/en/DATABASE_DESIGN.md. Enum values mirror
// packages/shared/src/enums.ts.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PROCESS_ENGINEER
  PRODUCTION_PLANNER
  WAREHOUSE_KEEPER
  STATION_OPERATOR
  QC_INSPECTOR
  MANAGER
}

// id equals auth.users.id in Supabase. station_id is added in Sprint 1 with `stations`.
model Profile {
  id        String   @id @db.Uuid
  fullName  String   @map("full_name")
  email     String   @unique
  role      Role
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("profiles")
}

// Append-only (BR-16): a trigger in the migration blocks UPDATE, DELETE and TRUNCATE.
// Polymorphic on purpose (entity_type, entity_id), so it has no foreign keys.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  action     String
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  actorId    String?  @map("actor_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
